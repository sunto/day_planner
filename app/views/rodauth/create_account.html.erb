<section class="auth-shell">
  <div class="auth-panel">
    <div class="auth-card">
      <%= render "auth_card_logo" %>
      <div class="auth-card-intro">
        <h2 class="auth-title">Create account</h2>
        <p class="auth-subtitle">Set up your starter account to get into the app.</p>
      </div>

      <%= form_with url: rodauth.create_account_path, method: :post, data: { turbo: false }, class: "auth-form" do |form| %>
        <div class="auth-field">
          <%= form.label "login", rodauth.login_label, class: "auth-label" %>
          <%= form.email_field rodauth.login_param, value: params[rodauth.login_param], id: "login", autocomplete: "email", required: true, class: "auth-input #{'auth-input-error' if rodauth.field_error(rodauth.login_param)}", aria: ({ invalid: true, describedby: "login_error_message" } if rodauth.field_error(rodauth.login_param)) %>
          <%= content_tag(:span, rodauth.field_error(rodauth.login_param), class: "auth-error", id: "login_error_message") if rodauth.field_error(rodauth.login_param) %>
        </div>

        <% if rodauth.require_login_confirmation? %>
          <div class="auth-field">
            <%= form.label "login-confirm", rodauth.login_confirm_label, class: "auth-label" %>
            <%= form.email_field rodauth.login_confirm_param, value: params[rodauth.login_confirm_param], id: "login-confirm", autocomplete: "email", required: true, class: "auth-input #{'auth-input-error' if rodauth.field_error(rodauth.login_confirm_param)}", aria: ({ invalid: true, describedby: "login-confirm_error_message" } if rodauth.field_error(rodauth.login_confirm_param)) %>
            <%= content_tag(:span, rodauth.field_error(rodauth.login_confirm_param), class: "auth-error", id: "login-confirm_error_message") if rodauth.field_error(rodauth.login_confirm_param) %>
          </div>
        <% end %>

        <% if rodauth.create_account_set_password? %>
          <div class="auth-field">
            <%= form.label "password", rodauth.password_label, class: "auth-label" %>
            <%= form.password_field rodauth.password_param, value: "", id: "password", autocomplete: rodauth.password_field_autocomplete_value, required: true, class: "auth-input #{'auth-input-error' if rodauth.field_error(rodauth.password_param)}", aria: ({ invalid: true, describedby: "password_error_message" } if rodauth.field_error(rodauth.password_param)) %>
            <%= content_tag(:span, rodauth.field_error(rodauth.password_param), class: "auth-error", id: "password_error_message") if rodauth.field_error(rodauth.password_param) %>
          </div>

          <% if rodauth.require_password_confirmation? %>
            <div class="auth-field">
              <%= form.label "password-confirm", rodauth.password_confirm_label, class: "auth-label" %>
              <%= form.password_field rodauth.password_confirm_param, value: "", id: "password-confirm", autocomplete: "new-password", required: true, class: "auth-input #{'auth-input-error' if rodauth.field_error(rodauth.password_confirm_param)}", aria: ({ invalid: true, describedby: "password-confirm_error_message" } if rodauth.field_error(rodauth.password_confirm_param)) %>
              <%= content_tag(:span, rodauth.field_error(rodauth.password_confirm_param), class: "auth-error", id: "password-confirm_error_message") if rodauth.field_error(rodauth.password_confirm_param) %>
            </div>
          <% end %>
        <% end %>

        <%= form.submit rodauth.create_account_button, class: "auth-button" %>
      <% end %>

      <div class="auth-secondary">
        <ul class="auth-footer">
          <li><%= link_to "Login", rodauth.login_path, class: "auth-link" %></li>
        </ul>
      </div>
    </div>
  </div>
</section>

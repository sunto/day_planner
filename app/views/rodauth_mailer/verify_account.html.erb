<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;background:#edf3f5;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:560px;border-collapse:separate;border-spacing:0;background:#ffffff;border-radius:24px;">
        <tr>
          <td style="padding:32px;font-family:'Instrument Sans','Avenir Next','Helvetica Neue',sans-serif;color:#14323d;">
            <p style="margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:0.24em;text-transform:uppercase;color:#5d7280;">
              Starter app account
            </p>

            <h1 style="margin:0;font-size:30px;line-height:1.1;letter-spacing:-0.04em;color:#14323d;">
              Verify your account
            </h1>

            <p style="margin:16px 0 0;font-size:16px;line-height:1.6;color:#5d7280;">
              Your starter app account is ready to verify.
              Use the button below to set your password and finish activating your account.
            </p>

            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:28px 0 0;border-collapse:separate;border-spacing:0;">
              <tr>
                <td style="border-radius:999px;background:#1d7a72;">
                  <a
                    href="<%= @rodauth.verify_account_email_link %>"
                    style="display:inline-block;padding:14px 24px;font-size:15px;font-weight:700;line-height:1;color:#ffffff;text-decoration:none;border-radius:999px;background:#1d7a72;"
                  >
                    Verify account
                  </a>
                </td>
              </tr>
            </table>

            <p style="margin:28px 0 0;font-size:14px;line-height:1.6;color:#5d7280;">
              If the button doesn’t work, open this link in your browser:
            </p>

            <p style="margin:8px 0 0;font-size:14px;line-height:1.6;word-break:break-word;">
              <a href="<%= @rodauth.verify_account_email_link %>" style="color:#145b56;word-break:break-word;"><%= @rodauth.verify_account_email_link %></a>
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

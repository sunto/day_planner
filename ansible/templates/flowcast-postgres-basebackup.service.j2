[Unit]
Description=Flowcast Postgres nightly base backup to object storage
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=POSTGRES_CONTAINER_NAME={{ postgres_backup_container_name }}
Environment=POSTGRES_DATA_DIR={{ postgres_backup_data_dir }}
ExecStart=/usr/local/libexec/flowcast/postgres/backup-base.sh

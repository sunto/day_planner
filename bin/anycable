#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export ANYCABLE_RPC_HOST="${ANYCABLE_RPC_HOST:-127.0.0.1:50051}"
export ANYCABLE_REDIS_URL="${ANYCABLE_REDIS_URL:-${REDIS_URL:-redis://localhost:16379/0}}"
export ANYCABLE_REDIS_CHANNEL="${ANYCABLE_REDIS_CHANNEL:-__anycable__}"
export REDIS_URL="${REDIS_URL:-$ANYCABLE_REDIS_URL}"

exec bundle exec anycable "$@"
